{
  "manifest_version": 3,
  "name": "Filtro de Estudio para Gemini Notebook",
  "version": "1.3.2",
  "description": "Filtra tipos de estudio y fuentes en Gemini Notebook (antes NotebookLM) sin romper la SPA.",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": [
    "https://notebook.google.com/*",
    "https://notebooklm.google.com/*",
    "https://accounts.google.com/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://notebook.google.com/*",
        "https://notebooklm.google.com/*"
      ],
      "js": ["filter-core.js", "page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://notebook.google.com/*",
        "https://notebooklm.google.com/*"
      ],
      "js": ["site-access.js", "filter-core.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon16.png", "icon48.png", "icon128.png"],
      "matches": [
        "https://notebook.google.com/*",
        "https://notebooklm.google.com/*"
      ]
    }
  ]
}
